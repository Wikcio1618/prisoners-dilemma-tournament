---
import Layout from "@/layouts/Layout.astro";
import JoinTournamentForm from "@/components/tournament/JoinTournamentForm";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
// Preserved across a failed attempt so the player does not retype a 6-digit code.
const code = Astro.url.searchParams.get("code") ?? "";
---

<Layout title="Dołącz do turnieju">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Dołącz do turnieju
      </h1>
      <JoinTournamentForm serverError={error} initialCode={code} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Chcesz utworzyć własny? <a href="/tournaments/new" class="text-purple-300 hover:underline">Nowy turniej</a>
      </p>
    </div>
  </div>
</Layout>
